# Postgres
DATABASE_URL=postgres://carnival:carnival@localhost:5432/carnival_mailing

# Redis (colas de envio con BullMQ)
REDIS_URL=redis://localhost:6379

# Amazon SES (worker de envio)
SES_REGION=eu-west-1
# Msgs/seg del worker hacia SES - subir cuando se salga de sandbox
SES_RATE_LIMIT_PER_SECOND=5
WORKER_CONCURRENCY=5
# URL publica de apps/api - el worker la usa para armar el pixel de open,
# el link de click-tracking y el link de unsubscribe embebidos en cada email
APP_BASE_URL=http://localhost:3000
# Credenciales AWS: no van aca, se leen de la cadena estandar del SDK
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY en el entorno, o ~/.aws/credentials)

# Token del endpoint de bounce/complaint (SNS no manda headers custom, va en la URL):
# generar con `openssl rand -hex 32` y configurar la suscripcion SNS apuntando a
# https://<host>/webhooks/ses/<este-token>
SES_WEBHOOK_TOKEN=

# ARN exacto del topico SNS que manda los bounces/complaints. Se valida junto
# con la firma del mensaje: sin esto, cualquiera con su propia cuenta de AWS
# podria conseguir un mensaje genuinamente firmado por SNS (para un topico
# propio) y reusarlo aca.
SES_SNS_TOPIC_ARN=

# WooCommerce REST API
WC_URL=https://example.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Secreto configurado en WooCommerce > Settings > Advanced > Webhooks
WC_WEBHOOK_SECRET=

PORT=3000
