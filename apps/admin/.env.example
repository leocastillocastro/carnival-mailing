# apps/admin - validado por src/env.ts (tambien lo lee scripts/createUser.ts)
# CHANGE_ME = POSTGRES_PASSWORD / REDIS_PASSWORD de infra/.env
DATABASE_URL=postgres://carnival:CHANGE_ME@localhost:5432/carnival_mailing
REDIS_URL=redis://:CHANGE_ME@localhost:6379

PORT=3001
# Solo loopback por defecto. Para acceso desde la LAN: HOST=0.0.0.0, siempre
# detras de un firewall (el admin no tiene TLS).
HOST=127.0.0.1
NODE_ENV=development
# false mientras se sirva por HTTP plano (local o LAN): el navegador descarta
# una cookie Secure sin TLS y el login no funciona.
SECURE_COOKIES=false

# Desde donde se sirven las imagenes subidas: apps/api expone /uploads/*.
UPLOADS_PUBLIC_URL=http://localhost:3000
# Sitio WordPress publico cuya biblioteca de medios se puede explorar desde
# el editor de plantillas (solo lectura, sin auth).
WORDPRESS_URL=https://example.com
