<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> · Carnival admin</title>
<style>
  /* Same brand palette and headline face the campaigns customers actually
     receive use — instead of an unrelated generic admin-tool look. Body text
     stays a plain system sans: Sans Merci is a heavy display face (fine for
     an email headline, too loud/monotone-weight for dense UI — every label,
     button and table cell reading the same visual weight actively hurts
     scanability). Brothers Regular already self-hosted at /fonts for the
     template editor's canvas preview. */
  @font-face { font-family: 'Brothers Regular'; src: url('/fonts/brothers-regular.otf'); font-weight: normal; font-style: normal; font-display: swap; }

  :root {
    color-scheme: light;
    --bg: #fbfaf8;
    --surface: #ffffff;
    --ink: #1e2a38;
    --ink-soft: #4a4740;
    --muted: #8a8578;
    --border: #e5e0d8;
    --accent: #b5342a;
    --accent-dark: #8f281f;
    --accent-soft: #fbeae8;
  }
  * { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; color: var(--ink); background: var(--bg); }
  a { color: var(--accent); }
  h1, h2 { font-family: 'Brothers Regular', Georgia, serif; font-weight: normal; color: var(--ink); }
  h1 { font-size: 2rem; letter-spacing: 0.01em; margin: 0 0 1.5rem; }
  h2 { font-size: 1.3rem; margin: 2rem 0 1rem; }
  /* A long form (campaign creation: content, sender, audience) reads as one
     undifferentiated stack of fields without these — a light section label,
     not a full headline, so three of them in one form don't compete with h1. */
  h2.form-section { font-family: inherit; font-size: 0.78rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin: 2rem 0 1.25rem; }
  h2.form-section:first-child { margin-top: 0; }
  header { background: var(--ink); color: #fbfaf8; padding: 0.9rem 1.75rem; display: flex; align-items: center; gap: 1.75rem; }
  header a.brand { color: #fbfaf8; text-decoration: none; font-family: 'Brothers Regular', Georgia, serif; font-size: 1.2rem; letter-spacing: 0.02em; }
  header a.brand span { font-size: 0.7rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: #b9c2ca; margin-left: 0.35rem; }
  header nav { display: flex; gap: 1.4rem; flex: 1; }
  header nav a { color: #d8dde1; text-decoration: none; padding-bottom: 0.2rem; border-bottom: 2px solid transparent; font-size: 0.92rem; }
  header nav a:hover { color: #fbfaf8; }
  header nav a.active { color: #fbfaf8; font-weight: bold; border-bottom-color: var(--accent); }
  header form { margin: 0; }
  header button { background: none; border: none; color: #d8dde1; cursor: pointer; font: inherit; font-size: 0.92rem; padding: 0; }
  header button:hover { color: #fbfaf8; }
  /* Deliberately not a floating white card with a shadow — that "dashboard
     widget" treatment is the single most recognizable generated-admin-UI
     tell there is. Content sits directly on the page background instead,
     the way the rest of this brand's own material (the emails) does. */
  main { max-width: 64rem; margin: 0 auto; padding: 2.5rem 2.25rem 4rem; }
  .flash { background: #dcfce7; border: 1px solid #16a34a; color: #14532d; padding: 0.75rem 1rem; border-radius: 0.4rem; margin-bottom: 1.25rem; }
  .error { background: #fee2e2; border: 1px solid #dc2626; color: #7f1d1d; padding: 0.75rem 1rem; border-radius: 0.4rem; margin-bottom: 1.25rem; }
  table { border-collapse: collapse; width: 100%; margin-top: 1rem; font-size: 0.93rem; }
  th, td { text-align: left; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: bold; }
  tbody tr:hover { background: #faf7f2; }
  label { display: block; margin-bottom: 1.1rem; }
  /* The browser's own [hidden]{display:none} rule lives in the UA stylesheet,
     which always loses to any author rule of equal importance regardless of
     specificity — so the label rule above silently overrides `hidden` on any
     <label>. Restore hidden's actual meaning explicitly. */
  [hidden] { display: none !important; }
  label span { display: block; font-weight: bold; margin-bottom: 0.3rem; font-size: 0.92rem; }
  input[type=text], input[type=email], input[type=password], input[type=number], select, textarea {
    width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 0.4rem; font: inherit; color: var(--ink); background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  textarea { font-family: ui-monospace, monospace; min-height: 12rem; }
  button.primary, input[type=submit] {
    background: var(--accent); color: #fff; border: none; padding: 0.65rem 1.4rem; border-radius: 0.4rem; font: inherit; font-weight: bold; cursor: pointer;
    transition: background-color 0.15s ease;
  }
  button.primary:hover, input[type=submit]:hover { background: var(--accent-dark); }
  button.secondary { background: #fff; border: 1px solid var(--border); color: var(--ink); padding: 0.65rem 1.4rem; border-radius: 0.4rem; font: inherit; cursor: pointer; transition: background-color 0.15s ease; }
  button.secondary:hover { background: var(--bg); }
  /* Deleting a list/segment/template/campaign is irreversible — this used to
     be styled identically to "Cancelar" (same neutral secondary button),
     giving no visual warning before an unrecoverable action. */
  button.danger { background: #fff; border: 1px solid #dc2626; color: #dc2626; padding: 0.65rem 1.4rem; border-radius: 0.4rem; font: inherit; font-weight: bold; cursor: pointer; transition: background-color 0.15s ease, color 0.15s ease; }
  button.danger:hover { background: #dc2626; color: #fff; }
  button.send { background: #b45309; color: #fff; border: none; padding: 0.65rem 1.4rem; border-radius: 0.4rem; font: inherit; font-weight: bold; cursor: pointer; }
  button.send:hover { background: #92400e; }
  .send-zone { border: 1px solid #fde68a; background: #fffbeb; border-radius: 0.5rem; padding: 1.1rem; margin-top: 2rem; }
  .send-zone-label { margin: 0 0 0.75rem; color: #78350f; font-size: 0.9rem; }
  .audience-count { margin: -0.5rem 0 1rem; color: var(--muted); font-size: 0.9rem; }
  .field-hint { margin: -0.75rem 0 1rem; color: var(--muted); font-size: 0.85rem; }
  .empty-state { border: 1px dashed var(--border); border-radius: 0.5rem; padding: 1.5rem; margin-top: 1rem; color: var(--ink-soft); background: var(--bg); }
  .empty-state p:first-child { margin-top: 0; font-weight: bold; color: var(--ink); }
  .empty-state p:last-child { margin-bottom: 0; }
  .segment-count { margin: 0.5rem 0 1rem; color: var(--muted); font-size: 0.9rem; }
  .actions { display: flex; gap: 0.6rem; margin-top: 1.5rem; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; }
  .toolbar h1 { margin: 0; }
  .status-pill { display: inline-block; padding: 0.22rem 0.7rem; border-radius: 999px; font-size: 0.78rem; font-weight: bold; white-space: nowrap; }
  .status-pill[data-status="sent"], .status-pill[data-status="subscribed"] { background: #dcfce7; color: #166534; }
  .status-pill[data-status="sending"], .status-pill[data-status="queued"] { background: #fef3c7; color: #92400e; }
  .status-pill[data-status="scheduled"] { background: #dbeafe; color: #1e40af; }
  .status-pill[data-status="draft"], .status-pill[data-status="paused"], .status-pill[data-status="suppressed"], .status-pill[data-status="unsubscribed"] { background: var(--border); color: var(--ink-soft); }
  .status-pill[data-status="failed"], .status-pill[data-status="bounced"], .status-pill[data-status="complained"] { background: #fee2e2; color: #991b1b; }
  .rule-group { border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.75rem; margin: 0.5rem 0; background: #fff; }
  .rule-group-header { margin-bottom: 0.5rem; font-size: 0.9rem; }
  .rule-item { display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem; }
  /* A dashed border alone barely separated from the white card behind it —
     a light tint makes the nesting (card > rule-group > condition) legible
     at a glance instead of relying on a thin dashed line to carry it. */
  .rule-condition { flex: 1; border: 1px dashed var(--border); border-radius: 0.4rem; padding: 0.6rem 0.75rem; background: var(--bg); }
  .rule-fields { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.4rem; }
  /* width:auto alone left these at the browser's default fixed input width
     (~20 characters) regardless of content — clipping longer placeholders
     like "estado del pedido (opcional)" instead of sizing to fit them. */
  .rule-fields input, .rule-fields select { width: auto; flex: 1 1 11rem; min-width: 11rem; }
  .rule-add { display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
  .remove-btn { background: #fee2e2; border: 1px solid #dc2626; border-radius: 0.4rem; cursor: pointer; padding: 0.3rem 0.6rem; align-self: flex-start; }
  #template-editor-root { border: 1px solid var(--border); border-radius: 0.4rem; margin-bottom: 1rem; overflow: hidden; }
  #template-editor-root:empty { display: none; }
  label.html-fallback textarea { min-height: 20rem; }
  /* Same hairline-divider, small-caps-label, serif-headline vocabulary the
     real customer emails use (see the templates table) — not a boxed
     feature-card grid, which is the other classic generated-dashboard tell. */
  .home-eyebrow { color: var(--muted); font-size: 0.72rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
  .home-list { margin-top: 2rem; border-top: 1px solid var(--border); }
  .home-item { display: grid; grid-template-columns: 8rem 1fr; gap: 1.5rem; padding: 1.75rem 0; border-bottom: 1px solid var(--border); text-decoration: none; }
  .home-item-label { color: var(--muted); font-size: 0.72rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; padding-top: 0.3rem; }
  .home-item-title { display: block; font-family: 'Brothers Regular', Georgia, serif; font-size: 1.6rem; color: var(--ink); margin-bottom: 0.4rem; transition: color 0.15s ease; }
  .home-item-desc { display: block; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.5; max-width: 34rem; }
  .home-item:hover .home-item-title { color: var(--accent); }
  /* A few fixed numbers, not a configurable widget dashboard — Mautic's own
     users report even simple counters being hard to set up in its general
     widget framework; nobody needs that flexibility here. */
  .home-stats { display: flex; gap: 2.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .home-stat-value { display: block; font-family: 'Brothers Regular', Georgia, serif; font-size: 2.1rem; color: var(--ink); line-height: 1; }
  .home-stat-label { display: block; color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; margin-top: 0.35rem; }
  /* Campaign form wizard: same fields as before, split into named steps —
     .wizard-step visibility is toggled by campaign-wizard.js, not by hiding
     via CSS alone, so [hidden]'s existing rule above covers it. */
  .wizard-tabs { display: flex; flex-wrap: wrap; gap: 0 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 1.75rem; }
  .wizard-tab { background: none; border: none; border-bottom: 2px solid transparent; color: var(--muted); font: inherit; font-size: 0.85rem; font-weight: bold; padding: 0 0 0.7rem; cursor: pointer; }
  .wizard-tab:hover { color: var(--ink); }
  .wizard-tab.active { color: var(--ink); border-bottom-color: var(--accent); }
  .wizard-step-nav { display: flex; justify-content: space-between; margin-top: 1.75rem; }
  .wizard-fieldset { border: none; margin: 0; padding: 0; min-width: 0; }
  .row-actions { display: flex; gap: 0.9rem; align-items: center; white-space: nowrap; }
  .pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; color: var(--muted); font-size: 0.88rem; }
  .row-actions form { margin: 0; }
  .link-button { background: none; border: none; padding: 0; margin: 0; color: var(--accent); font: inherit; cursor: pointer; text-decoration: none; }
  .link-button:hover { text-decoration: underline; }
</style>
</head>
<body>
<% if (it.user) { %>
<header>
  <a href="/" class="brand">Carnival<span>admin</span></a>
  <nav>
    <a href="/" class="<%= it.activeNav === "home" ? "active" : "" %>">Inicio</a>
    <a href="/lists" class="<%= it.activeNav === "lists" ? "active" : "" %>">Listas</a>
    <a href="/templates" class="<%= it.activeNav === "templates" ? "active" : "" %>">Templates</a>
    <a href="/segments" class="<%= it.activeNav === "segments" ? "active" : "" %>">Segmentos</a>
    <a href="/campaigns" class="<%= it.activeNav === "campaigns" ? "active" : "" %>">Campañas</a>
  </nav>
  <span><%= it.user.email %></span>
  <form method="post" action="/logout"><button type="submit">Salir</button></form>
</header>
<% } %>
<main>
  <% if (it.flash) { %><div class="flash"><%= it.flash %></div><% } %>
  <% if (it.error) { %><div class="error"><%= it.error %></div><% } %>
  <%~ it.body %>
</main>
</body>
</html>
