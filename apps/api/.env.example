# apps/api - validado por src/env.ts
# CHANGE_ME = POSTGRES_PASSWORD / REDIS_PASSWORD de infra/.env
DATABASE_URL=postgres://carnival:CHANGE_ME@localhost:5432/carnival_mailing
# Solo lo usa scripts/sendCampaign.ts (encola en BullMQ); el servidor no.
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# WooCommerce REST API. Para desarrollo local basta con cualquier valor no
# vacio; las claves reales solo hacen falta para scripts/backfill.ts.
WC_URL=https://example.com
WC_CONSUMER_KEY=ck_CHANGE_ME
WC_CONSUMER_SECRET=cs_CHANGE_ME
# Secreto configurado en WooCommerce > Settings > Advanced > Webhooks
WC_WEBHOOK_SECRET=CHANGE_ME

# Token del endpoint de bounce/complaint (SNS no manda headers custom, va en
# la URL: https://<host>/webhooks/ses/<este-token>). Minimo 20 caracteres:
# generar con `openssl rand -hex 32`.
SES_WEBHOOK_TOKEN=
# ARN exacto del topico SNS que manda los bounces/complaints. Se valida junto
# con la firma del mensaje.
SES_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:CHANGE_ME
# @carnival/mailer construye el cliente SES al importarse y falla sin esto.
SES_REGION=eu-west-1

# Hosts a los que puede redirigir el click-tracking (separados por coma; un
# subdominio de un host listado tambien vale).
TRACKING_ALLOWED_REDIRECT_HOSTS=example.com,www.google.com,wa.me

PORT=3000
