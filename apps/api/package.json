    "@carnival/mailer": "workspace:*",
    "@carnival/queue": "workspace:*",
    "@carnival/segments": "workspace:*",
    "@carnival/woocommerce": "workspace:*",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
