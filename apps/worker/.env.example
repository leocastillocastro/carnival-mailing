# apps/worker - validado por src/env.ts
# CHANGE_ME = POSTGRES_PASSWORD / REDIS_PASSWORD de infra/.env
DATABASE_URL=postgres://carnival:CHANGE_ME@localhost:5432/carnival_mailing
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# Amazon SES. Las credenciales AWS no van aca: se leen de la cadena estandar
# del SDK (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY en el entorno, o
# ~/.aws/credentials).
SES_REGION=eu-west-1
# Msgs/seg hacia SES - subir cuando se salga de sandbox
SES_RATE_LIMIT_PER_SECOND=5
WORKER_CONCURRENCY=5

# URL publica de apps/api - se usa para armar el pixel de open, el link de
# click-tracking y el de unsubscribe embebidos en cada email.
APP_BASE_URL=http://localhost:3000
